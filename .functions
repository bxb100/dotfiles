#!/usr/bin/env zsh

# This file is sourced by zsh. Keep helpers private by prefixing them with "_".

unalias open 2>/dev/null
unfunction diff 2>/dev/null

_require_command() {
  local required_command="$1"

  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'ERROR: Required command not found: %s\n' "$required_command" >&2
    return 127
  fi
}

_open() {
  local target

  if [[ "$OSTYPE" == darwin* ]]; then
    _require_command open || return
    command open "$@"
    return
  fi

  if [[ -r /proc/version ]] && command grep -qi microsoft /proc/version; then
    _require_command explorer.exe || return
    for target in "$@"; do
      command explorer.exe "$target" || return
    done
    return
  fi

  _require_command xdg-open || return
  for target in "$@"; do
    command xdg-open "$target" || return
  done
}

# Create a directory and enter it.
mkd() {
  if (( $# != 1 )); then
    printf 'Usage: mkd <directory>\n' >&2
    return 2
  fi

  command mkdir -p -- "$1" || return
  builtin cd -- "$1"
}

# Change to the location of the frontmost Finder window.
cdf() {
  local directory

  _require_command osascript || return
  directory=$(
    command osascript -e \
      'tell app "Finder" to POSIX path of (insertion location as alias)'
  ) || return

  if [[ -z "$directory" || ! -d "$directory" ]]; then
    printf 'ERROR: Finder did not return a valid directory.\n' >&2
    return 1
  fi

  builtin cd -- "$directory"
}

# Create a gzip-compressed tar archive from one file or directory.
targz() {
  local source_path source_parent source_name archive_path temporary_archive

  if (( $# < 1 || $# > 2 )); then
    printf 'Usage: targz <source> [archive.tar.gz]\n' >&2
    return 2
  fi

  source_path="$1"
  if [[ ! -e "$source_path" ]]; then
    printf 'ERROR: Source does not exist: %s\n' "$source_path" >&2
    return 1
  fi

  source_path="${source_path:a}"
  if [[ "$source_path" == / ]]; then
    printf 'ERROR: Refusing to archive the filesystem root.\n' >&2
    return 1
  fi
  source_parent="${source_path:h}"
  source_name="${source_path:t}"
  archive_path="${2:-${source_name}.tar.gz}"
  if [[ -e "$archive_path" ]]; then
    printf 'ERROR: Archive already exists: %s\n' "$archive_path" >&2
    return 1
  fi

  temporary_archive=$(command mktemp -t targz.XXXXXX) || return
  (
    trap 'command rm -f -- "$temporary_archive"' EXIT HUP INT TERM

    command tar -C "$source_parent" -czf "$temporary_archive" \
      --exclude='.DS_Store' \
      -- "$source_name" || exit
    command mv -- "$temporary_archive" "$archive_path" || exit
    trap - EXIT HUP INT TERM
  ) || return

  printf '%s created successfully.\n' "$archive_path"
}

# Show disk usage for the requested paths or every item in the current directory.
fs() {
  local -a targets

  if (( $# )); then
    targets=("$@")
  else
    targets=(./*(DN))
    (( ${#targets} )) || targets=(.)
  fi

  command du -sh -- "${targets[@]}"
}

# Compare two paths using Git's word-colored diff.
gdiff() {
  if (( $# != 2 )); then
    printf 'Usage: gdiff <path-a> <path-b>\n' >&2
    return 2
  fi

  _require_command git || return
  command git diff --no-index --color-words -- "$1" "$2"
}

# Create a data URL from a file.
dataurl() {
  local mime_type

  if (( $# != 1 )); then
    printf 'Usage: dataurl <file>\n' >&2
    return 2
  fi
  if [[ ! -f "$1" || ! -r "$1" ]]; then
    printf 'ERROR: File is not readable: %s\n' "$1" >&2
    return 1
  fi

  _require_command file || return
  _require_command openssl || return
  mime_type=$(command file -b --mime-type -- "$1") || return
  if [[ "$mime_type" == text/* ]]; then
    mime_type="${mime_type};charset=utf-8"
  fi

  printf 'data:%s;base64,' "$mime_type"
  command openssl base64 -A -in "$1" || {
    printf '\n'
    return 1
  }
  printf '\n'
}

# Serve a directory locally or through a temporary Cloudflare Tunnel.
server() {
  local directory="." port="8000"
  local remote=0 open_browser=0
  local -a positional

  while (( $# )); do
    case "$1" in
      --remote)
        remote=1
        ;;
      --open)
        open_browser=1
        ;;
      --)
        shift
        positional+=("$@")
        break
        ;;
      -*)
        printf 'ERROR: Unknown option: %s\n' "$1" >&2
        return 2
        ;;
      *)
        positional+=("$1")
        ;;
    esac
    shift
  done
  set -- "${positional[@]}"

  if (( $# > 2 )); then
    printf 'Usage: server [--remote] [--open] [directory] [port]\n' >&2
    return 2
  fi

  if (( $# == 1 )) && [[ "$1" == <-> ]]; then
    port="$1"
  else
    directory="${1:-.}"
    port="${2:-8000}"
  fi

  if [[ ! -d "$directory" ]]; then
    printf 'ERROR: Directory does not exist: %s\n' "$directory" >&2
    return 1
  fi
  if [[ "$port" != <-> ]] || (( port < 1 || port > 65535 )); then
    printf 'ERROR: Invalid port: %s\n' "$port" >&2
    return 2
  fi

  _require_command http-server || return
  if (( remote )); then
    _require_command cloudflared || return

    (
      local http_server_pid tunnel_status
      local tunnel_log="" watcher_pid=""

      setopt local_options no_bg_nice
      command http-server \
        --host 127.0.0.1 \
        --port "$port" \
        "$directory" &
      http_server_pid=$!

      trap '
        if [[ -n "$watcher_pid" ]]; then
          command kill "$watcher_pid" 2>/dev/null
          wait "$watcher_pid" 2>/dev/null
        fi
        command kill "$http_server_pid" 2>/dev/null
        wait "$http_server_pid" 2>/dev/null
        if [[ -n "$tunnel_log" ]]; then
          command rm -f -- "$tunnel_log"
        fi
      ' EXIT
      trap 'exit 130' HUP INT TERM

      sleep 1
      if ! command kill -0 "$http_server_pid" 2>/dev/null; then
        wait "$http_server_pid"
        return 1
      fi

      printf 'Starting a temporary Cloudflare Tunnel...\n'
      if (( open_browser )); then
        tunnel_log=$(command mktemp -t cloudflared.XXXXXX) || return
        (
          local attempt remote_url

          for attempt in {1..120}; do
            remote_url=$(
              command grep -Eo \
                'https://[[:alnum:]-]+\.trycloudflare\.com' \
                "$tunnel_log" 2>/dev/null |
                command head -n 1
            )
            if [[ -n "$remote_url" ]]; then
              if ! _open "$remote_url" >/dev/null 2>&1; then
                printf 'WARNING: Failed to open the remote URL.\n' >&2
              fi
              exit
            fi
            sleep 0.25
          done

          printf 'WARNING: Timed out waiting for the remote URL.\n' >&2
        ) &
        watcher_pid=$!

        command cloudflared tunnel \
          --url "http://localhost:${port}" \
          --logfile "$tunnel_log"
        tunnel_status=$?
      else
        command cloudflared tunnel \
          --url "http://localhost:${port}"
        tunnel_status=$?
      fi
      return "$tunnel_status"
    )
    return
  fi

  if (( open_browser )); then
    (sleep 1 && _open "http://localhost:${port}/" >/dev/null 2>&1) &!
  fi
  command http-server \
    --host 127.0.0.1 \
    --port "$port" \
    "$directory"
}

# Compare original and gzip-compressed file sizes.
gz() {
  local original_size compressed_size ratio

  if (( $# != 1 )); then
    printf 'Usage: gz <file>\n' >&2
    return 2
  fi
  if [[ ! -f "$1" || ! -r "$1" ]]; then
    printf 'ERROR: File is not readable: %s\n' "$1" >&2
    return 1
  fi

  _require_command gzip || return
  setopt local_options pipe_fail
  original_size=$(command wc -c <"$1") || return
  compressed_size=$(command gzip -cn -- "$1" | command wc -c) || return

  printf 'orig: %d bytes\n' "$original_size"
  if (( original_size == 0 )); then
    printf 'gzip: %d bytes (ratio unavailable for an empty file)\n' \
      "$compressed_size"
    return
  fi

  ratio=$(command awk \
    -v compressed="$compressed_size" \
    -v original="$original_size" \
    'BEGIN { printf "%.2f", compressed * 100 / original }'
  ) || return
  printf 'gzip: %d bytes (%s%% of original)\n' "$compressed_size" "$ratio"
}

# Display DNS answers for a domain and optional record type.
digga() {
  local record_type

  if (( $# < 1 || $# > 2 )); then
    printf 'Usage: digga <domain> [record-type]\n' >&2
    return 2
  fi
  if [[ "$1" == -* ]]; then
    printf 'ERROR: Invalid domain: %s\n' "$1" >&2
    return 2
  fi

  record_type="${2:-ANY}"
  _require_command dig || return
  command dig +nocmd "$1" "$record_type" +multiline +noall +answer
}

# Retrieve the Common Name and Subject Alternative Names from a TLS certificate.
getcertnames() {
  local domain port certificate subject common_name san_output

  if (( $# < 1 || $# > 2 )); then
    printf 'Usage: getcertnames <domain> [port]\n' >&2
    return 2
  fi

  domain="$1"
  port="${2:-443}"
  if [[ -z "$domain" || "$domain" == -* ]]; then
    printf 'ERROR: Invalid domain: %s\n' "$domain" >&2
    return 2
  fi
  if [[ "$port" != <-> ]] || (( port < 1 || port > 65535 )); then
    printf 'ERROR: Invalid port: %s\n' "$port" >&2
    return 2
  fi

  _require_command openssl || return
  setopt local_options pipe_fail
  certificate=$(
    command openssl s_client \
      -connect "${domain}:${port}" \
      -servername "$domain" \
      </dev/null 2>/dev/null |
      command openssl x509 -outform PEM 2>/dev/null
  ) || {
    printf 'ERROR: Failed to retrieve a certificate from %s:%s.\n' \
      "$domain" "$port" >&2
    return 1
  }

  subject=$(
    printf '%s\n' "$certificate" |
      command openssl x509 \
        -noout \
        -subject \
        -nameopt sep_multiline,utf8
  ) || return
  common_name=$(
    printf '%s\n' "$subject" |
      command awk '
        /^[[:space:]]*CN=/ {
          sub(/^[[:space:]]*CN=/, "")
          print
          exit
        }
      '
  ) || return

  san_output=$(
    printf '%s\n' "$certificate" |
      command openssl x509 -noout -ext subjectAltName 2>/dev/null
  ) || san_output=""

  printf 'Common Name:\n%s\n' "${common_name:-(not present)}"
  printf '\nSubject Alternative Names:\n'
  if [[ -z "$san_output" ||
    "$san_output" != *'Subject Alternative Name'* ]]; then
    printf '(not present)\n'
    return
  fi

  printf '%s\n' "$san_output" |
    command awk '
      NR == 1 { next }
      {
        line = $0
        sub(/^[[:space:]]+/, "", line)
        count = split(line, entries, /,[[:space:]]*/)
        for (entry_index = 1; entry_index <= count; entry_index++) {
          sub(/^DNS:/, "", entries[entry_index])
          print entries[entry_index]
        }
      }
    '
}

# Open the current directory or the supplied locations.
o() {
  if (( $# == 0 )); then
    _open .
  else
    _open "$@"
  fi
}

# Display a colored tree and page long output.
tre() {
  _require_command tree || return
  _require_command less || return
  setopt local_options pipe_fail
  command tree \
    -aC \
    -I '.git|node_modules|bower_components' \
    --dirsfirst \
    "$@" |
    command less -FRNX
}

# Download once, verify its SHA-256 digest, and print only verified content.
checksum() {
  local url expected temporary_file digest_output actual

  if (( $# < 1 || $# > 2 )); then
    printf 'Usage: checksum <https-url> [sha256]\n' >&2
    return 2
  fi

  url="$1"
  expected="${2:-}"
  if [[ -n "$expected" ]] &&
    { (( ${#expected} != 64 )) || [[ "$expected" == *[^[:xdigit:]]* ]]; }; then
    printf 'ERROR: Expected digest must be a 64-character SHA-256 value.\n' >&2
    return 2
  fi

  _require_command curl || return
  temporary_file=$(command mktemp -t checksum.XXXXXX) || return
  (
    trap 'command rm -f -- "$temporary_file"' EXIT HUP INT TERM

    command curl \
      --fail \
      --silent \
      --show-error \
      --location \
      --proto '=https' \
      --tlsv1.2 \
      --output "$temporary_file" \
      "$url" || exit

    if command -v shasum >/dev/null 2>&1; then
      digest_output=$(command shasum -a 256 "$temporary_file") || exit
    elif command -v sha256sum >/dev/null 2>&1; then
      digest_output=$(command sha256sum "$temporary_file") || exit
    else
      printf 'ERROR: Neither shasum nor sha256sum is installed.\n' >&2
      exit 127
    fi
    actual="${digest_output%% *}"

    if [[ -z "$expected" ]]; then
      printf '%s\n' "$actual"
      exit
    fi

    expected="${expected:l}"
    if [[ "$actual" != "$expected" ]]; then
      printf 'ERROR: Checksum verification failed.\n' >&2
      printf 'Expected: %s\nActual:   %s\n' "$expected" "$actual" >&2
      exit 1
    fi

    command cat -- "$temporary_file"
  )
}

# Pull the current Git repository and immediate child repositories.
gitup() {
  local -a candidates
  local directory
  local exit_code=0

  _require_command git || return
  candidates=("$PWD" "$PWD"/*(/N))

  for directory in "${candidates[@]}"; do
    if ! command git -C "$directory" rev-parse --git-dir >/dev/null 2>&1; then
      continue
    fi

    printf 'Updating %s...\n' "$directory"
    command git -C "$directory" pull --ff-only --prune || exit_code=1
  done

  return "$exit_code"
}

# Remove conventional Rust target directories from the current project level.
clean_rust_targets() {
  local -a manifests
  local manifest target_directory
  local exit_code=0

  if (( $# != 0 )); then
    printf 'Usage: clean_rust_targets\n' >&2
    return 2
  fi

  manifests=("$PWD"/Cargo.toml(N) "$PWD"/*/Cargo.toml(N))
  for manifest in "${manifests[@]}"; do
    target_directory="${manifest:h}/target"
    [[ -d "$target_directory" ]] || continue

    printf 'Removing %s...\n' "$target_directory"
    command rm -rf -- "$target_directory" || exit_code=1
  done

  return "$exit_code"
}

# Backward-compatible wrapper for the old misspelled name.
earse-target() {
  printf 'WARNING: earse-target is deprecated; use clean_rust_targets.\n' >&2
  clean_rust_targets "$@"
}

# Remove Maven markers created by failed artifact downloads.
maven_clean_failed_downloads() {
  local repository_root="$HOME/.m2/repository"

  [[ -d "$repository_root" ]] || return
  command find "$repository_root" \
    -type f \
    -name '*.lastUpdated' \
    -exec grep -q 'Could not transfer' {} \; \
    -print \
    -delete
}

# Backward-compatible name.
mavenclean() {
  maven_clean_failed_downloads "$@"
}

# Backward-compatible alias for mkd.
md() {
  mkd "$@"
}

# Open the current GitHub repository, including jj-backed repositories.
openg() {
  local repository remote_output

  _require_command gh || return
  if command -v jj >/dev/null 2>&1 &&
    command jj root >/dev/null 2>&1; then
    remote_output=$(command jj git remote list) || return
    repository=$(
      printf '%s\n' "$remote_output" |
        command awk '
          $1 == "origin" {
            print $2
            found = 1
            exit
          }
          NR == 1 { fallback = $2 }
          END {
            if (!found && fallback != "") {
              print fallback
            }
          }
        '
    ) || return

    if [[ -z "$repository" ]]; then
      printf 'ERROR: No jj Git remote was found.\n' >&2
      return 1
    fi
    command gh repo view "$repository" --web
    return
  fi

  command gh repo view --web
}

# Individual Gradle cache files must not be removed by access time.
gradleclean() {
  printf '%s\n' \
    'ERROR: gradleclean is disabled because partial cache deletion is unsafe.' \
    'Use the project clean task or remove a complete cache intentionally.' >&2
  return 2
}

# Preview a readable text file with the best available pager.
preview() {
  if (( $# != 1 )); then
    printf 'Usage: preview <file>\n' >&2
    return 2
  fi
  if [[ ! -f "$1" || ! -r "$1" ]]; then
    printf 'ERROR: File is not readable: %s\n' "$1" >&2
    return 1
  fi

  if [[ "${1:l}" == *.md ]] && command -v glow >/dev/null 2>&1; then
    command glow -p -- "$1"
  elif command -v bat >/dev/null 2>&1; then
    command bat --paging=always -- "$1"
  elif command -v less >/dev/null 2>&1; then
    command less -- "$1"
  else
    command sed -n '1,200p' -- "$1"
  fi
}

# Run Yazi and change to its final directory.
y() {
  local temporary_file final_directory
  local yazi_status cd_status=0

  _require_command yazi || return
  temporary_file=$(command mktemp -t yazi-cwd.XXXXXX) || return

  command yazi "$@" --cwd-file="$temporary_file"
  yazi_status=$?

  if [[ -r "$temporary_file" ]]; then
    IFS= read -r -d '' final_directory <"$temporary_file" || :
    if [[ -n "$final_directory" && "$final_directory" != "$PWD" ]]; then
      builtin cd -- "$final_directory" || cd_status=$?
    fi
  fi

  command rm -f -- "$temporary_file"
  (( cd_status == 0 )) || return "$cd_status"
  return "$yazi_status"
}

# Trim leading and trailing whitespace while preserving internal whitespace.
trim() {
  command awk '
    {
      sub(/^[[:space:]]+/, "")
      sub(/[[:space:]]+$/, "")
      print
    }
  '
}
